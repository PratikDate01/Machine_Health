# AI Machine Health Monitor Environment Configuration

# Server & API Settings
HOST=0.0.0.0
PORT=8000
API_SECRET_KEY=demo-secret-token-change-in-production
REQUIRE_DEVICE_AUTH=false

# Streamlit Dashboard Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Database Configuration
DATABASE_PATH=data/machine_health.db

# Live Monitor Settings
HEARTBEAT_TIMEOUT_SECONDS=10
STALE_TIMEOUT_SECONDS=5

# Baseline Thresholds (Demo Rules - Not Certified Safety Limits)
EXTERNAL_TEMP_WARN_C=45.0
EXTERNAL_TEMP_CRIT_C=60.0
IMU_TEMP_WARN_C=50.0
IMU_TEMP_CRIT_C=65.0
VIBRATION_WARN_G=0.25
VIBRATION_CRIT_G=0.60

# ML Model Defaults
DEFAULT_CONTAMINATION=0.05
RANDOM_STATE=42

# Optional Alert Notifications (Disabled by default)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=change_this_password
NOTIFICATION_RECIPIENT=alerts@example.com
